{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "RustDesk Workspace",
  "version": "0.1.0",
  "identifier": "com.rustdesk.workspace",
  "build": {
    "beforeDevCommand": "cd ../rustdesk-workspace-frontend && pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../rustdesk-workspace-frontend && pnpm build",
    "frontendDist": "../rustdesk-workspace-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RustDesk Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Rust个人效率工作台",
    "longDescription": "一个高性能、本地优先、安全、可扩展的个人生产力中心，融合了 Notion 的知识管理、Obsidian 的本地知识库、Raycast 的快捷操作、Linear 的极简项目管理。"
  },
  "plugins": {
    "sql": {
      "preload": []
    }
  }
}
